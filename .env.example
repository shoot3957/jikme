# PostgreSQL (Supabase 또는 Neon 무료 플랜)
DATABASE_URL="postgresql://user:password@host:5432/jikme"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="openssl rand -base64 32 로 생성"

# 카카오 로그인 (Kakao Developers에서 발급)
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""

# Supabase Storage (프로필/커버 이미지 업로드) — service_role 키는 서버 전용, 절대 클라이언트에 노출 금지
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="public-images"

# Socket.io 서버 (별도 배포 시 실제 도메인으로 교체)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"
# Socket.io 서버의 CORS 허용 origin 목록 (콤마로 구분, 여러 개 가능)
# 지정하지 않으면 NEXT_PUBLIC_APP_URL 하나만 허용하고, 그것도 없으면 http://localhost:3000로 대체됨
ALLOWED_ORIGINS="http://localhost:3000,https://jikme.vercel.app"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 로컬 개발용 포트. 실제 배포(Railway 등)에서는 플랫폼이 주입하는 PORT가 우선 사용됨
SOCKET_PORT=4000

# Next.js 서버 -> Socket.io 서버로 실시간 push를 위임하는 내부 엔드포인트 인증/주소
# SOCKET_INTERNAL_SECRET은 두 서버에 동일한 값으로 설정해야 함 (openssl rand -base64 24 등으로 생성)
SOCKET_INTERNAL_SECRET=""
SOCKET_SERVER_INTERNAL_URL="http://localhost:4000"
